[Unit]
Description=CalComp DrawingBoard III menu areas and drawing-area mapping
Documentation=file://%h/.local/lib/calcomp-menud/README.md
# Needs the graphical session for commands like konsole (WAYLAND_DISPLAY etc.)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/lib/calcomp-menud/calcomp_menud.py run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
